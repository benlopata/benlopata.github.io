---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>Hi, I'm Ben</h1>
				<p class="tagline">Full Stack Engineer | GenAI/LLM Integration | Python & TypeScript Expert</p>
				<p class="intro">
					Full Stack Engineer with 6+ years building scalable consumer applications in ever-evolving startup environments.
					Expert across the stack with deep experience in FastAPI, NestJS, Redis, and GenAI/LLM integration.
					I deliver high-impact features from concept to production in fast-paced environments.
				</p>
			</div>

			<div class="sections-grid">
				<a href="/projects" class="section-card">
					<h2>Projects</h2>
					<p>Check out some of the projects I've worked on and the technologies I've used.</p>
				</a>

				<a href="/resume" class="section-card">
					<h2>Resume</h2>
					<p>Learn more about my professional experience, education, and skills.</p>
				</a>

				<a href="/blog" class="section-card">
					<h2>Blog</h2>
					<p>Read my latest thoughts on software development, tech trends, and more.</p>
				</a>

				<a href="/contact" class="section-card">
					<h2>Contact</h2>
					<p>Get in touch with me for collaboration opportunities or just to say hello.</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}

	.hero {
		text-align: center;
		padding: 3em 0 4em 0;
	}

	.hero h1 {
		font-size: 3em;
		margin-bottom: 0.5em;
		background: linear-gradient(135deg, rgb(var(--accent)) 0%, rgb(var(--accent-dark)) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.tagline {
		font-size: 1.3em;
		color: rgb(var(--gray-dark));
		margin-bottom: 1em;
	}

	.intro {
		font-size: 1.1em;
		line-height: 1.6;
		max-width: 600px;
		margin: 0 auto;
	}

	.sections-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin-top: 3rem;
	}

	.section-card {
		padding: 2rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s ease;
	}

	.section-card:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-4px);
		border-color: rgb(var(--accent));
	}

	.section-card h2 {
		margin-top: 0;
		color: rgb(var(--accent));
		font-size: 1.5em;
	}

	.section-card p {
		margin-bottom: 0;
		color: rgb(var(--gray-dark));
		line-height: 1.6;
	}

	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2em;
		}

		.tagline {
			font-size: 1.1em;
		}

		.intro {
			font-size: 1em;
		}

		.sections-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
