---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description="My projects and work" />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Projects</h1>
				<p>Here are some of my notable projects:</p>

				<div class="projects-grid">
					<div class="project-card featured">
						<h3>SiteSage</h3>
						<p class="project-tagline">RAG-like search on any webpage!</p>
						<div class="video-container">
							<iframe scrolling='no' frameborder='0' style='width: 100%; height: 628px; border:0;' src='https://app.screencast.com/9dUkYTiOEFoAI/e' allowfullscreen></iframe>
						</div>
						<p>A Chrome extension using Jina Reader API to provide a foundational LLM with the page contents for RAG-like search. Useful for querying research papers, technical documentation, or any dense text.</p>
					</div>

					<div class="project-card">
						<h3>@YouSimDotAI Twitter Bot</h3>
						<p>Autonomous Twitter bot that generates AI simulations from trending topics and user mentions, driving over 1M organic impressions through automated content generation and engagement systems.</p>
						<div class="project-links">
							<a href="https://twitter.com/YouSimDotAI" target="_blank">View on Twitter</a>
						</div>
					</div>

					<div class="project-card">
						<h3>bloombot.ai Platform</h3>
						<p>Developed 20+ core platform features including LLM-backed real-time conversation handling using OpenRouter, LangFuse, and Django, with comprehensive testing and monitoring infrastructure.</p>
						<div class="project-links">
							<a href="https://bloombot.ai" target="_blank">View Site</a>
						</div>
					</div>

					<div class="project-card">
						<h3>RAG Applications with Audio Processing</h3>
						<p>Developed Retrieval-Augmented Generation applications using LlamaIndex, Python, FastAPI, and Redis, processing over 1,000 hours of audio and improving data accessibility by 40%.</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}

	h1 {
		font-size: 2.5em;
		margin-bottom: 0.5em;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

	.project-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 1.5rem;
		transition: box-shadow 0.2s ease;
	}

	.project-card.featured {
		grid-column: 1 / -1;
		background: linear-gradient(135deg, rgba(var(--accent), 0.05) 0%, rgba(var(--accent), 0.02) 100%);
		border: 2px solid rgb(var(--accent));
	}

	.project-card:hover {
		box-shadow: var(--box-shadow);
	}

	.project-card h3 {
		margin-top: 0;
		color: rgb(var(--accent));
	}

	.project-tagline {
		font-size: 1.1em;
		font-style: italic;
		color: rgb(var(--gray-dark));
		margin-bottom: 1rem;
	}

	.video-container {
		margin: 1.5rem 0;
		border-radius: 8px;
		overflow: hidden;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.video-container iframe {
		display: block;
	}

	.project-links {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	.project-links a {
		padding: 0.5rem 1rem;
		background: rgb(var(--accent));
		color: white;
		text-decoration: none;
		border-radius: 4px;
		font-size: 0.9em;
		transition: opacity 0.2s ease;
	}

	.project-links a:hover {
		opacity: 0.8;
	}

	@media (max-width: 720px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}

		.video-container {
			max-width: 100%;
		}

		.video-container iframe {
			height: 500px;
		}
	}
</style>
