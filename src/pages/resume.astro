---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import resumePdf from '../assets/ben-lopata-software-engineer-cv.pdf';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Resume | ${SITE_TITLE}`} description="Resume and professional experience of Ben Lopata" />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="pdf-viewer-section">
					<div class="pdf-container">
						<iframe src={resumePdf} title="Ben Lopata Resume PDF"></iframe>
					</div>
				</div>

				<div class="download-section">
					<a href={resumePdf} download="Ben_Lopata_Resume.pdf" class="download-btn">Download PDF Resume</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}

	.download-section {
		text-align: center;
		margin-top: 2rem;
	}

	.download-btn {
		display: inline-block;
		padding: 1rem 2rem;
		background: rgb(var(--accent));
		color: white;
		text-decoration: none;
		border-radius: 8px;
		font-weight: bold;
		transition: opacity 0.2s ease;
	}

	.download-btn:hover {
		opacity: 0.8;
	}

	.pdf-viewer-section {
		margin-bottom: 2rem;
	}

	.pdf-container {
		width: 100%;
		height: 800px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		overflow: hidden;
		background: white;
	}

	.pdf-container iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	@media (max-width: 720px) {
		.pdf-container {
			height: 600px;
		}
	}
</style>
