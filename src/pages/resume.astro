---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import resumePdf from '../assets/ben-lopata-software-engineer-cv.pdf';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Resume | ${SITE_TITLE}`} description="Resume and professional experience of Ben Lopata" />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Resume</h1>

				<div class="resume-summary">
					<p>
						Full Stack Engineer with 8+ years building scalable consumer applications in ever-evolving startup environments.
						Expert across the stack—Python, TypeScript, React, Next.js, Postgres—with deep experience in FastAPI, NestJS, Redis, and
						GenAI/LLM integration. I deliver high-impact features from concept to production in fast-paced environments.
					</p>
				</div>

				<div class="download-section-top">
					<a href={resumePdf} download="Ben_Lopata_Resume.pdf" class="download-btn">Download PDF Resume</a>
				</div>

				<div class="resume-section">
					<h2>Experience</h2>

					<div class="resume-item">
						<div class="resume-header">
							<h3>Full-Stack Software Engineer</h3>
							<span class="date">Feb 2025 - Present</span>
						</div>
						<h4>Cardio Diagnostics | Chicago, IL</h4>
						<ul>
							<li>Led a cross-functional team to define requirements, translate business needs into user stories, to build a web application from the ground up for customers to order tests, view results, and manage workflows.</li>
							<li>Architected, built, and deployed a RAG pipeline using AWS Bedrock and OpenSearch that enabled clinicians to rapidly access and interpret insights from epigenetic blood test results, enhancing explainability of outputs.</li>
						</ul>
					</div>

					<div class="resume-item">
						<div class="resume-header">
							<h3>Founding Engineer</h3>
							<span class="date">Sep 2024 - Jan 2025</span>
						</div>
						<h4>Plastic Labs | New York, NY (Remote)</h4>
						<ul>
							<li>Architected and deployed @YouSimDotAI, an autonomous Twitter bot using Python and Twitter/X's API that generates AI simulations from trending topics and user mentions, driving over 1M organic impressions through automated content generation and engagement systems.</li>
							<li>Spearheaded development of 20+ core platform features for bloombot.ai including LLM-backed real-time conversation handling using OpenRouter, LangFuse, and Django, authentication flows, and settings management, while implementing comprehensive testing and monitoring infrastructure.</li>
						</ul>
					</div>

					<div class="resume-item">
						<div class="resume-header">
							<h3>Software Engineer & Co-Founder</h3>
							<span class="date">Jul 2023 - Aug 2024</span>
						</div>
						<h4>Evans Gambit | Waterville, OH (Remote)</h4>
						<ul>
							<li>Architected and developed a SaaS business reporting solution using Next.js, Node.js, and React.js, integrating generative AI to enhance decision-making capabilities.</li>
							<li>Developed Retrieval-Augmented Generation (RAG) applications using LlamaIndex, Python, FastAPI, and Redis, processing over 1,000 hours of audio and improving data accessibility by 40%.</li>
						</ul>
					</div>

					<div class="resume-item">
						<div class="resume-header">
							<h3>Full-Stack Software Engineer</h3>
							<span class="date">Mar 2022 - Mar 2023</span>
						</div>
						<h4>GenoPalate | Milwaukee, WI (Remote)</h4>
						<ul>
							<li>Solutioned and implemented system integrations and automation with Python, Terraform, and AWS Lambda, decreasing processing times by 95% and enhancing data throughput by 35%.</li>
							<li>Directed cross-platform application development in React, React Native, and TypeScript, achieving a 18% increase in user base through superior UI/UX and performance optimizations.</li>
						</ul>
					</div>

					<div class="resume-item">
						<div class="resume-header">
							<h3>Full-Stack Software Engineer</h3>
							<span class="date">Jun 2020 - Jan 2022</span>
						</div>
						<h4>Prodly | Chicago, IL (Remote)</h4>
						<ul>
							<li>Pioneered greenfield Salesforce solutions, developing 15+ React and Node.js features using AWS Elastic Beanstalk and S3, implementing CloudWatch monitoring to improve stability and NPS by 30%.</li>
							<li>Developed robust testing protocols with Jest and Selenium, reducing bugs by 20% and ensuring high system stability.</li>
						</ul>
					</div>

					<div class="resume-item">
						<div class="resume-header">
							<h3>Operational Support Engineer</h3>
							<span class="date">Jun 2017 - May 2020</span>
						</div>
						<h4>Southwest Power Pool | Little Rock, AR</h4>
						<ul>
							<li>Implemented seamless automation for daily deliverables using Python, MongoDB, and distributed computing, reducing costs by 16% and enhancing reliability of the bulk electric system.</li>
							<li>Developed a C# application for real-time streaming data visualization using .NET Core, which halved analysis time and improved customized reporting capabilities.</li>
						</ul>
					</div>
				</div>

				<div class="resume-section">
					<h2>Technical Skills</h2>
					<div class="skills-grid">
						<div>
							<h4>Languages</h4>
							<p>Python, TypeScript, Elixir</p>
						</div>
						<div>
							<h4>Frontend</h4>
							<p>React.js, Next.js, Mantine, React Query</p>
						</div>
						<div>
							<h4>Backend</h4>
							<p>FastAPI, Node.js, Nest.js, Django</p>
						</div>
						<div>
							<h4>Databases</h4>
							<p>MongoDB, PostgreSQL, Redis, DynamoDB, SQLAlchemy, Prisma</p>
						</div>
						<div>
							<h4>Cloud & DevOps</h4>
							<p>AWS (Lambda, ECS, RDS), Docker, Kubernetes, Terraform, GitLab, Git Actions</p>
						</div>
						<div>
							<h4>AI/ML</h4>
							<p>LlamaIndex, Azure OpenAI service, Amazon Bedrock, LangFuse, Comet, OpenSearch</p>
						</div>
						<div>
							<h4>Libraries</h4>
							<p>Pandas, PyTorch, Tensorflow</p>
						</div>
					</div>
				</div>

				<div class="resume-section">
					<h2>Education</h2>

					<div class="resume-item">
						<div class="resume-header">
							<h3>Bachelor of Science, Electrical Engineering</h3>
							<span class="date">2017</span>
						</div>
						<h4>Louisiana Tech University | Ruston, LA</h4>
					</div>
				</div>

				<div class="pdf-viewer-section">
					<h2>View Full Resume</h2>
					<div class="pdf-container">
						<iframe src={resumePdf} title="Ben Lopata Resume PDF"></iframe>
					</div>
				</div>

				<div class="download-section">
					<a href={resumePdf} download="Ben_Lopata_Resume.pdf" class="download-btn">Download PDF Resume</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}

	h1 {
		font-size: 2.5em;
		margin-bottom: 1em;
	}

	.resume-section {
		margin-bottom: 3rem;
	}

	.resume-section h2 {
		font-size: 1.8em;
		margin-bottom: 1rem;
		color: rgb(var(--accent));
		border-bottom: 2px solid rgb(var(--accent));
		padding-bottom: 0.5rem;
	}

	.resume-item {
		margin-bottom: 2rem;
	}

	.resume-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 0.5rem;
	}

	.resume-header h3 {
		margin: 0;
		font-size: 1.3em;
	}

	.resume-header .date {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}

	.resume-item h4 {
		margin: 0.25rem 0 0.75rem 0;
		font-weight: normal;
		color: rgb(var(--gray-dark));
	}

	.resume-item ul {
		margin: 0.5rem 0;
		padding-left: 1.5rem;
	}

	.resume-item li {
		margin-bottom: 0.5rem;
		line-height: 1.6;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
		margin-top: 1rem;
	}

	.skills-grid h4 {
		margin-top: 0;
		margin-bottom: 0.5rem;
		color: rgb(var(--gray-dark));
	}

	.skills-grid p {
		margin: 0;
		line-height: 1.6;
	}

	.resume-summary {
		background: rgb(var(--gray-light), 0.3);
		padding: 1.5rem;
		border-radius: 8px;
		margin-bottom: 2rem;
	}

	.resume-summary p {
		margin: 0;
		font-size: 1.05em;
		line-height: 1.7;
	}

	.download-section-top {
		text-align: center;
		margin-bottom: 3rem;
	}

	.download-section {
		text-align: center;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.download-btn {
		display: inline-block;
		padding: 1rem 2rem;
		background: rgb(var(--accent));
		color: white;
		text-decoration: none;
		border-radius: 8px;
		font-weight: bold;
		transition: opacity 0.2s ease;
	}

	.download-btn:hover {
		opacity: 0.8;
	}

	.pdf-viewer-section {
		margin-top: 3rem;
		margin-bottom: 2rem;
	}

	.pdf-viewer-section h2 {
		font-size: 1.8em;
		margin-bottom: 1rem;
		color: rgb(var(--accent));
		border-bottom: 2px solid rgb(var(--accent));
		padding-bottom: 0.5rem;
	}

	.pdf-container {
		width: 100%;
		height: 800px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		overflow: hidden;
		background: white;
	}

	.pdf-container iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	@media (max-width: 720px) {
		.resume-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.resume-header .date {
			margin-top: 0.25rem;
		}

		.skills-grid {
			grid-template-columns: 1fr;
		}

		.pdf-container {
			height: 600px;
		}
	}
</style>
